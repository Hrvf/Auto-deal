# Copier en .env et adapter
AUTODEAL_ENV=production
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer
# SQLite (simple) ou PostgreSQL (recommandé en ligne)
DATABASE_URL=postgresql+psycopg://autodeal:motdepasse@db:5432/autodeal
# Mettre true dès que le site est servi en HTTPS
HTTPS_ONLY=true
# Jeton exigé pour créer le premier compte via /installation en production
SETUP_TOKEN=a-remplacer
MAX_UPLOAD_MB=15
